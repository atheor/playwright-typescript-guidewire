# Guidewire Environment Configuration
# Copy to .env.local and fill in values - never commit real credentials

# Base URLs
POLICY_CENTER_URL=http://localhost:8080/pc
CLAIM_CENTER_URL=http://localhost:8080/cc
BILLING_CENTER_URL=http://localhost:8080/bc

# Default credentials (overridden per environment)
GW_USERNAME=admin
GW_PASSWORD=gw

# D365 SOAP Integration
D365_SOAP_URL=http://d365-instance/api/soap
D365_SOAP_USERNAME=d365user
D365_SOAP_PASSWORD=d365pass
D365_SOAP_TIMEOUT=30000

# Test environment (dev | staging | prod)
TEST_ENV=dev
